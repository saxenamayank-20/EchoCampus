# copy to .env and fill in. empty values fall back to the defaults in backend/app/core/config.py

# neon postgres url, empty = local sqlite file
DATABASE_URL=
JWT_SECRET=change-me-to-a-long-random-string

# staff accounts made on startup (AD100, GM101-GM104)
ADMIN_SEED_PASSWORD=
GM101_PASSWORD=
GM102_PASSWORD=
GM103_PASSWORD=
GM104_PASSWORD=

# the react app's address, for CORS and links in emails
FRONTEND_ORIGIN=http://localhost:5173
# e.g. college.edu, empty = any domain
ALLOWED_EMAIL_DOMAINS=

# gemini, empty = no ai (keyword rules only)
GEMINI_API_KEY=

# upstash redis, empty = in-memory cache
REDIS_URL=

# email. brevo api key = send over https (needed on render free, it blocks smtp)
# else smtp settings, else mails are printed in the backend log. SMTP_FROM is the sender for both
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# logo in the emails, empty = the frontend icon. set it when running locally (mail apps cannot load localhost)
EMAIL_LOGO_URL=
# who students contact when they're stuck (forgot details limit, password changed email). empty = SMTP_FROM
SUPPORT_EMAIL=

# set to false when a second copy of the backend runs
RUN_SCHEDULER=true
