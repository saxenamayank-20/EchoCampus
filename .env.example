# Copy this file to .env and fill in real values. Never commit .env.
# Variables marked "later" are used by upcoming phases and can stay empty for now.

# ── Seed account passwords (used now) ─────────────────────────────────────────
# Accounts with an empty password are not created. Use strong, unique values.
ADMIN_SEED_PASSWORD=
GM001_PASSWORD=
GM002_PASSWORD=
GM003_PASSWORD=
GM004_PASSWORD=

# ── Database (Phase 1.2 SQLite, Phase 3.1 Neon) ──────────────────────────────
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require

# ── Auth / API (later: Phase 2.1) ──────────────────────────────────────────────
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=30
ALLOWED_EMAIL_DOMAINS=
FRONTEND_ORIGIN=http://localhost:5173

# ── Email (later: Phase 2.1) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Redis, rate limits, SLA, uploads (later: Phase 2.2 / 3) ────────────────────
REDIS_URL=
RATE_LIMIT_COMPLAINTS_PER_HOUR=5
SLA_HOURS_CRITICAL=4
SLA_HOURS_HIGH=48
SLA_HOURS_MEDIUM=72
SLA_HOURS_LOW=168
CONFIRMATION_WINDOW_DAYS=3
MAX_UPLOAD_MB=5
MAX_FILES_PER_COMPLAINT=5

# ── AI (later: Phase 4) ──────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIM=
DUPLICATE_THRESHOLD=0.85
LLM_MAX_RPM=8

# ── Crisis support (later: Phase 4.1) ──────────────────────────────────────────
COUNSELLOR_CONTACT=
CRISIS_HELPLINE=Tele-MANAS 14416

# Note: VITE_API_BASE_URL=http://localhost:8000 goes in frontend/.env (Phase 2.3).
